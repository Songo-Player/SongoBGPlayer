# Cross compiles the engine for 64-bit Windows with MinGW-w64 on a Linux host.
# scripts/build_windows.sh builds and runs this, running itself inside.
#
# The posix thread model, since the engine uses std::thread; the DLL links
# libwinpthread, libgcc and libstdc++ statically.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc-mingw-w64-x86-64-posix \
        g++-mingw-w64-x86-64-posix \
        binutils-mingw-w64-x86-64 \
        gcc \
        libc6-dev \
        cmake \
        make \
        pkg-config \
        python3 \
        scons \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --set x86_64-w64-mingw32-gcc /usr/bin/x86_64-w64-mingw32-gcc-posix \
    && update-alternatives --set x86_64-w64-mingw32-g++ /usr/bin/x86_64-w64-mingw32-g++-posix

# Read by scripts/deps/ and the SConstruct, and by scripts/build_windows.sh to
# build here instead of starting Docker again
ENV CROSS_PREFIX=x86_64-w64-mingw32-
ENV SONGO_IN_WINDOWS_DOCKER=1
WORKDIR /src
