<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Keeps the engine playing while Songo is in the background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- CPU (and Wi-Fi, for streams) stay up with the screen off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <!-- Registers the Godot v2 plugin -->
        <meta-data
            android:name="org.godotengine.plugin.v2.SongoHarness"
            android:value="org.songo.harness.SongoHarnessPlugin" />

        <service
            android:name="org.songo.harness.SongoPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
